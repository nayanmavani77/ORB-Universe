# ===========================================================================
#  CREDENTIALS  —  copy this file to `.env` and fill it in
#
#      copy .env.example .env          (Windows)
#      cp   .env.example .env          (macOS / Linux)
#
#  `.env` is git-ignored and never leaves your machine. THIS file (.env.example)
#  is committed, so it must never contain a real key or password — it exists
#  only to show what `.env` needs.
#
#  The system reads `.env` automatically; nothing has to be exported by hand.
#  A real environment variable still wins over the file, so you can point one
#  command at a second account without editing anything:
#
#      $env:MT5_LOGIN="87654321"; python run_live.py --engine orb
# ===========================================================================


# --- Databento ------------------------------------------------------------
# Needed to DOWNLOAD history and to run LIVE. Not needed to backtest data you
# already have on disk. Key from https://databento.com  ->  Account -> API keys
DATABENTO_API_KEY=

# --- MetaTrader 5 ---------------------------------------------------------
# Live trading only. Your broker shows all three when the account is created.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional. Only needed if MT5 is not found automatically, or you run more than
# one terminal. Forward slashes are fine on Windows.
MT5_TERMINAL_PATH=
