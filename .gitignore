# ===========================================================================
#  What must never reach GitHub: market data, reports, trade files.
#
#  Two rules do most of the work — the output ROOTS below — but the file-type
#  rules are kept as well, because a run can be pointed anywhere with `--out`
#  and results written outside the standard folders must still be ignored.
# ===========================================================================

# --- market data ----------------------------------------------------------
# Large, slow to clone, and not ours to redistribute.
data/*
!data/.gitkeep
!data/README.md
*.parquet
*.dbn
*.dbn.zst
*.pq

# --- run outputs ----------------------------------------------------------
# Everything a run produces: backtest/<engine>/<run-name>/ and the sweeps.
backtest/
# the 24-case behaviour baseline — regenerate with
#   python tools/golden_master.py record
golden_master/
# staging area for files awaiting manual deletion
_to_delete/
# anything an older layout or a stray --out produced
backtest_out/
matrix_out*/
rr_matrix_out*/
reversal_*/
walk_forward*/
sweeps/
outputs/
matrix_summaries/

# --- reports --------------------------------------------------------------
# Every generated report. No HTML in this project is source.
*.html

# --- trade files and result tables ----------------------------------------
# No CSV in this project is source either — the config is YAML and the news
# calendar lives in it. If you ever add a source CSV, force it with:
#     git add -f path/to/file.csv
*.csv
*.csv.gz
*.tsv
all_results.csv
run_info.json
collect_info.json
*_summary/

# --- journals -------------------------------------------------------------
*.log

# --- archives and backups -------------------------------------------------
*.zip
*.gz
*.bak
*.bak[0-9]

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
